# Скопируйте этот файл в .env и заполните две первые строки.
# Файл .env в git не попадает (.gitignore). Ключ живёт только здесь:
# в базу данных, в логи и в браузер он не передаётся.

# --- Keitaro (обязательно) ---------------------------------------------------
# Адрес трекера без /admin на конце, например https://tracker.example.com
KEITARO_BASE_URL=
# Ключ Admin API: админка Keitaro → профиль (иконка справа вверху) → «API ключи»
KEITARO_API_KEY=

# --- База данных --------------------------------------------------------------
# По умолчанию SQLite-файл рядом с проектом: ничего ставить не нужно.
# PostgreSQL: pip install asyncpg и DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/adrobot
DATABASE_URL=sqlite+aiosqlite:///./data/adrobot.sqlite3

# --- Значения по умолчанию для «создаватора» (можно оставить пустыми) ---------
# Пусто = определить автоматически: единственная группа/источник/домен в трекере,
# а если ключу API не виден список доменов — самый частый домен среди кампаний.
# Те же значения можно поменять в интерфейсе: «Настройки».
DEFAULT_DOMAIN_ID=
DEFAULT_GROUP_ID=
DEFAULT_TRAFFIC_SOURCE_ID=
# Куда первый поток отправляет трафик из выбранной страны
DEFAULT_REDIRECT_URL=https://google.com
# Адрес трекинг-домена — только чтобы показывать готовую ссылку кампании (https://domain/alias)
TRACKING_DOMAIN_URL=

# --- Доступ к самому AdRobot ---------------------------------------------------
# Если задать — все запросы к /api потребуют заголовок Authorization: Bearer <токен>.
# Обязательно задайте, если открываете AdRobot не только на localhost.
ADROBOT_AUTH_TOKEN=

# --- Тонкая настройка клиента Keitaro -----------------------------------------
# Cloudflare перед трекером может банить «питоновские» User-Agent (ошибка 1010)
KEITARO_USER_AGENT=AdRobot-Keitaro/1.0
KEITARO_TIMEOUT_SECONDS=20
KEITARO_MAX_RETRIES=3
KEITARO_MAX_CONCURRENCY=4
# Сколько секунд держать в памяти справочники (офферы, группы, источники, домены)
DICTIONARY_TTL_SECONDS=300
LOG_LEVEL=INFO
